# AgentRouter / Claude 配置（只需把下面的令牌替换成真实值）
# Claude 使用 Anthropic Messages，Base URL 不要写 /v1。
LLM_API_FORMAT=anthropic
LLM_API_KEY=fill-your-agentrouter-token-here
LLM_BASE_URL=https://co.agentrouter.org
LLM_MODEL=claude-opus-5

# Claude 不提供本项目所需的 Embedding；保持 local 即可只使用一个令牌。
# 本地哈希向量不会被当作语义召回，在线检索会使用中文 bigram BM25。
EMBEDDING_MODE=local
EMBEDDING_MODEL=text-embedding-3-small

# 如将来需要独立的 OpenAI-compatible Embedding 服务，再填写这两项并把
# EMBEDDING_MODE 改为 openai；不填时 Anthropic 模式会继续使用 local。
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# 可选：NCBI 公共数据源访问配置
NCBI_API_KEY=
NCBI_EMAIL=evidence-mvp@example.com
