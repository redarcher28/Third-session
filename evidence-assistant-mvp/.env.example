# 大模型（OpenAI 兼容接口，也支持 DeepSeek）
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Embedding 独立端点（可选）
# DeepSeek 暂无 embedding 接口：留空会自动回退离线哈希向量；
# 若使用其他 OpenAI 兼容 embedding 服务，可分别指定：
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# auto：有 embedding 配置就用；offline：始终用离线哈希（DeepSeek 推荐）
EMBEDDING_MODE=auto

# NCBI / PubMed 礼貌访问（可选）
NCBI_API_KEY=
NCBI_EMAIL=evidence-mvp@example.com
