# OpenAI 兼容接口配置（复制为 .env 后填写）
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# 可选：NCBI E-utilities 礼貌访问
NCBI_API_KEY=
NCBI_EMAIL=evidence-mvp@example.com

# 可选：独立国内向量服务（硅基流动 / 阿里 DashScope / 智谱 的 OpenAI 兼容 embeddings 接口）
# 留空则使用 BM25 关键词检索
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# 可选：向量库落盘目录。Windows 下请用纯 ASCII 路径（如 C:\Users\xxx\ThirdSessionChroma），
# 因为 chromadb 的 Rust 索引写入器在含中文的路径下不会落盘。
# CHROMA_DIR=
