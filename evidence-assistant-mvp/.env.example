# OpenAI 兼容接口配置（复制为 .env 后填写）
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 可选：NCBI E-utilities 礼貌访问
NCBI_API_KEY=
NCBI_EMAIL=evidence-mvp@example.com

# 可选：独立国内向量服务（硅基流动 / 阿里 DashScope / 智谱 的 OpenAI 兼容 embeddings 接口）。
# 例：EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1 + EMBEDDING_MODEL=BAAI/bge-m3
# 留空 Key 时自动使用本地 fastembed 跑 BAAI/bge-small-zh-v1.5（免费离线，无需网络/Key）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# 可选：向量库落盘目录。Windows 下请用纯 ASCII 路径（如 C:\Users\xxx\ThirdSessionChroma），
# 因为 chromadb 的 Rust 索引写入器在含中文的路径下不会落盘。
# CHROMA_DIR=
