# ByeAPI / OpenAI Responses 配置（只需把下面的令牌替换成真实值）
# 对应 Codex 配置中的 wire_api = "responses"；Base URL 保持根地址。
LLM_API_FORMAT=responses
LLM_API_KEY=fill-your-byeapi-token-here
LLM_BASE_URL=https://api.byeapi.top
LLM_MODEL=gpt-5.6-luna
# 为空表示关闭额外推理强度调节；赛道 Prompt 与回答策略由后端统一控制。
LLM_REASONING_EFFORT=

# 默认关闭 LLM 二次重排，减少一次远程请求；需要时改为 true。
RAG_USE_LLM_RERANK=false
# 默认使用本地词法扩展，不额外调用远程模型；需要语义改写时改为 true。
RAG_USE_LLM_QUERY_REWRITE=false

# 启动后也可以打开 http://127.0.0.1:8000/settings，在前端修改以上连接项；
# 前端配置保存在用户目录私有运行时文件中，不会写入本仓库的 .env。

# 主前端由独立 Open WebUI 进程提供；FastAPI /fallback 仅作备用页。
OPENWEBUI_URL=http://127.0.0.1:8080/
# Open WebUI 主界面品牌名；启动脚本会把旧证据台说明合并到 Banner/示例问题。
OPENWEBUI_NAME=证据台

# Responses API 不保证提供 Embedding；保持 local 即可只使用一个令牌。
# 本地哈希向量不会被当作语义召回，在线检索会使用中文 bigram BM25。
EMBEDDING_MODE=local
EMBEDDING_MODEL=text-embedding-3-small

# 如将来需要独立的 OpenAI-compatible Embedding 服务，再填写这两项并把
# EMBEDDING_MODE 改为 openai；不填时 Responses 模式会继续使用 local。
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# 可选：NCBI 公共数据源访问配置
NCBI_API_KEY=
NCBI_EMAIL=evidence-mvp@example.com
